{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "projects": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "description": {
            "type": "string",
            "maxLength": 160
          },
          "color": {
            "type": "string",
            "enum": [
              "mint",
              "blue",
              "violet",
              "peach",
              "gold"
            ]
          },
          "pinned": {
            "type": "boolean"
          },
          "items": {
            "minItems": 1,
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "folder",
                    "file",
                    "app"
                  ]
                }
              },
              "required": [
                "id",
                "name",
                "path",
                "kind"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "color",
          "pinned",
          "items"
        ],
        "additionalProperties": false
      }
    },
    "preferences": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "minimum": 320,
          "maximum": 1120
        },
        "height": {
          "type": "number",
          "minimum": 64,
          "maximum": 160
        },
        "iconSize": {
          "type": "number",
          "minimum": 24,
          "maximum": 64
        },
        "radius": {
          "type": "number",
          "minimum": 12,
          "maximum": 32
        },
        "material": {
          "type": "string",
          "enum": [
            "frost",
            "soft",
            "solid"
          ]
        },
        "theme": {
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        },
        "reducedMotion": {
          "type": "boolean"
        },
        "autoHide": {
          "type": "boolean"
        }
      },
      "required": [
        "width",
        "height",
        "iconSize",
        "radius",
        "material",
        "theme",
        "reducedMotion",
        "autoHide"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "projects",
    "preferences"
  ],
  "additionalProperties": false
}