          "height": {
            "type": "number",
            "minimum": 64,
            "maximum": 160
          },
          "iconSize": {
            "type": "number",
            "minimum": 24,
            "maximum": 64
          },
          "radius": {
            "type": "number",
            "minimum": 12,
            "maximum": 32
          },
          "material": {
            "type": "string",
            "enum": [
              "frost",
              "soft",
              "solid"
            ]
          },
          "theme": {
            "type": "string",
            "enum": [
              "light",
              "dark"
            ]
          },
          "reducedMotion": {
            "type": "boolean"
          },
          "autoHide": {
